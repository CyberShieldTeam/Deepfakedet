# Copy to .env. Never use VITE_ prefixes for credentials.
PORT=3000
# Bind loopback for local-only evaluation; configure a protected listener for deployment.
# VERITAS_HOST=127.0.0.1
APP_GEMINI_API_KEY=
GEMINI_MODEL=

# Production: JSON object mapping random tokens (>=32 characters) to analyst/owner IDs.
# Generate tokens outside this file and inject via your deployment secret manager.
VERITAS_USERS={}
VERITAS_PUBLIC_ORIGIN=
# VERITAS_STORE=/absolute/path/on/persistent/volume/investigations.json

# Optional Google Fact Check Tools API; requires API enablement and quota.
GOOGLE_FACT_CHECK_API_KEY=

# Opt-in real encyclopedia retrieval, no API key. Queries leave this server for Wikimedia.
# Lead excerpts are candidates, never automatic fact-check verdicts; see docs/CLAIM_SOURCE_CITATIONS.md.
VERITAS_WIKIPEDIA_ENABLED=0
VERITAS_WIKIPEDIA_LANGUAGE=en

# Optional research NLI: failed held-out validation; never promotes factual verdicts.
# Explicit approved English assertion + English-tagged source required. No runtime downloads.
VERITAS_NLI_ENABLED=0
VERITAS_NLI_PYTHON=
VERITAS_NLI_MODEL_PATH=

# Versioned classifier adapters. No scores are returned when these are absent.
# Repeat suffixes for VERITAS_AUDIO and VERITAS_EMBEDDING.
VERITAS_IMAGE_ENDPOINT=
VERITAS_IMAGE_TOKEN=
VERITAS_IMAGE_MODEL_ID=
VERITAS_IMAGE_VERSION=
VERITAS_IMAGE_LICENSE=
VERITAS_IMAGE_TRAINING_DATA=
VERITAS_IMAGE_LIMITATIONS=
# Only claim calibration when fitted on a documented held-out set:
# VERITAS_IMAGE_TEMPERATURE=1.2
# VERITAS_IMAGE_CALIBRATION_REFERENCE=dataset-version-and-evaluation-report

VERITAS_AUDIO_ENDPOINT=
VERITAS_AUDIO_TOKEN=
VERITAS_AUDIO_MODEL_ID=
VERITAS_AUDIO_VERSION=
VERITAS_AUDIO_LICENSE=
VERITAS_AUDIO_TRAINING_DATA=
VERITAS_AUDIO_LIMITATIONS=
VERITAS_EMBEDDING_ENDPOINT=
VERITAS_EMBEDDING_TOKEN=
VERITAS_EMBEDDING_MODEL_ID=
VERITAS_EMBEDDING_VERSION=
VERITAS_EMBEDDING_LICENSE=
VERITAS_EMBEDDING_TRAINING_DATA=
VERITAS_EMBEDDING_LIMITATIONS=

# Optional pinned local Python service (ViT/Smaug screening, YuNet, AASIST, bounded video decode).
# These experimental outputs remain separate from calibrated classifier verdicts.
VERITAS_AI_SERVICE_URL=
# Optional preparation-only service; takes precedence for OCR only. Existing full-service fallback remains.
VERITAS_OCR_PREPARATION_URL=
# Python service settings:
VERITAS_IMAGE_MODEL_ENABLED=0
VERITAS_IMAGE_MODEL=smaug
# Supported Python adapters: dima, smaug, community. All remain experimental.
VERITAS_AUDIO_MODEL_ENABLED=0
VERITAS_FACE_MODEL_ENABLED=0

# Optional C2PA SDK: pip install -r ai_service/requirements-provenance.txt
# Python-only operator-managed PEM trust anchors. No uploaded certificate is auto-trusted.
# Remote manifest and OCSP network fetching remain disabled.
VERITAS_C2PA_TRUST_ANCHORS=

# Off by default. Explicit guided demo remains available in the UI.
VERITAS_DEMO_FEED=false

# Optional operator-approved claim evidence corpus (never a client-uploaded truth label).
# Schema/rights/approval and complete file SHA-256 required; see docs/CLAIM_VERIFICATION.md.
VERITAS_CLAIM_CORPUS=
VERITAS_CLAIM_CORPUS_SHA256=
# Existing VERITAS_EMBEDDING_ENDPOINT adapter supports local server-side inference.
# Use e5 only with a compatible endpoint/model; queries/passages get distinct prefixes.
VERITAS_CLAIM_EMBEDDING_FORMAT=
