# Copy to .env (same folder as package.json) and fill in. .env is gitignored and read only by the server.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model ID (gemini-2.5-flash is closed to new keys). On a 404 the server falls back to gemini-3.8-flash, then gemini-flash-latest.
GEMINI_MODEL=gemini-3.8-flash

# Optional: server port
PORT=3000

# Optional local Python image inference service. Start ai_service separately.
VERITAS_AI_SERVICE_URL=
# Set in the Python service environment to load the pinned checkpoint. With 0, installed YuNet weights still provide unverified face candidates.
VERITAS_IMAGE_MODEL_ENABLED=0
# Python service: dima (legacy experimental) or smaug (replacement under evaluation)
VERITAS_IMAGE_MODEL=smaug

# Python service: set to 1 only after downloading the pinned official AASIST checkpoint.
VERITAS_AUDIO_MODEL_ENABLED=0
