{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VERITAS image evaluation manifest",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["path", "task", "label", "group", "split", "source", "license", "license_uri", "label_basis", "sha256"],
    "properties": {
      "path": {"type": "string", "minLength": 1},
      "task": {"enum": ["general_image", "face_manipulation"]},
      "label": {"enum": ["real", "synthetic", "unaltered", "manipulated"]},
      "group": {"type": "string", "minLength": 1},
      "split": {"enum": ["train", "validation", "holdout", "smoke"]},
      "source": {"type": "string", "minLength": 1},
      "license": {"type": "string", "minLength": 1},
      "license_uri": {"type": "string", "minLength": 1},
      "label_basis": {"type": "string", "minLength": 1},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "subgroup": {"type": "object"},
      "limitations": {"type": "string"}
    }
  }
}
