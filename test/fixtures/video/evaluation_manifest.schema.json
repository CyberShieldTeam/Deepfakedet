{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VERITAS development temporal evaluation manifest",
  "type": "object",
  "required": ["schema_version", "task", "evaluation_role", "protocol_sha256", "samples"],
  "properties": {
    "schema_version": {"const": 1},
    "task": {"const": "video_temporal_diagnostics"},
    "evaluation_role": {"const": "development"},
    "protocol_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_path": {"type": "string", "minLength": 1},
    "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/video"}}
  },
  "$defs": {
    "video": {
      "type": "object",
      "required": ["id", "task", "path", "sha256", "dataset", "dataset_version", "cohort", "ground_truth",
        "label_basis", "label_reference", "source", "license", "license_uri", "group", "source_ids",
        "subject_ids", "identity_status", "split", "contamination_status", "manipulation_type", "conditions", "metadata", "encoding", "annotations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "task": {"const": "video_temporal"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "cohort": {"enum": ["software_control", "camera_recording", "independent_manipulation"]},
        "ground_truth": {"enum": ["not_applicable", "authentic", "manipulated", "ai_generated"]},
        "identity_status": {"enum": ["verified", "not_applicable"]},
        "split": {"enum": ["development", "validation"]},
        "contamination_status": {"const": "reviewed_no_known_overlap"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "subject_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "parent_id": {"type": ["string", "null"]},
        "metadata": {
          "type": "object", "required": ["fps", "width", "height", "frames", "fourcc", "frame_rate_mode"],
          "properties": {
            "fps": {"type": "number", "exclusiveMinimum": 0},
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1},
            "frames": {"type": "integer", "minimum": 1, "maximum": 3600},
            "fourcc": {"type": "integer", "minimum": 1},
            "frame_rate_mode": {"const": "constant_verified"}
          }
        },
        "encoding": {"type": "object", "required": ["codec", "container", "pixel_format"]},
        "annotations": {
          "type": "object", "required": ["status", "intervals"],
          "properties": {"status": {"enum": ["none", "software_generated", "independently_verified"]}, "intervals": {"type": "array"}}
        }
      }
    }
  },
  "$comment": "The Python admission gate additionally verifies operator authorization, hashes, lineage/split separation, native metadata, annotations and resource budgets. Schema validation alone is not admission."
}
